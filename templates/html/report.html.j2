<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <title>{{ metadata.report.title }}</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 28px; color: #222; line-height: 1.45; }
    h1, h2, h3, h4 { margin-top: 1.2em; }
    table { width: 100%; border-collapse: collapse; margin: 10px 0 22px; font-size: 13px; }
    th, td { border: 1px solid #cfd6dd; padding: 7px; text-align: left; vertical-align: top; }
    th { background: #f3f5f7; }
    code { white-space: pre-wrap; word-break: break-all; }
    .status { font-weight: 700; }
    .PASS { background: #eef8ef; }
    .WARN { background: #fff8e5; }
    .FAIL { background: #fdecec; }
    .SKIPPED { background: #f3f3f3; }
    .host-detail { margin: 24px 0 34px; padding-top: 10px; border-top: 2px solid #d8dde3; }
    .diagnostic { margin: 14px 0 24px; }
    .muted { color: #666; }
    .target-systems th, .target-systems td { text-align: center; }
    .target-systems td:nth-child(3), .target-systems td:nth-child(4) { text-align: left; }
    .wide { overflow-x: auto; }
    details { margin: 8px 0; }
  </style>
</head>
<body>
  <header>
    <h1>{{ metadata.report.title }}</h1>
    <p>{{ metadata.customer.name }}</p>
    {% if metadata.report.report_date %}<p>작성일자: {{ metadata.report.report_date }}</p>{% endif %}
  </header>

  <section id="overview">
    <h2>1. 구조진단 개요</h2>
    <table>
      <tr><th>고객사</th><td>{{ metadata.customer.name }}</td><th>구독 유무</th><td>{{ metadata.customer.subscription or '-' }}</td></tr>
      <tr><th>기간</th><td>{{ metadata.execution.period.start or '-' }} ~ {{ metadata.execution.period.end or '-' }}</td><th>장소</th><td>{{ metadata.execution.location or metadata.customer.site or '-' }}</td></tr>
      <tr><th>고객 담당자</th><td colspan="3">{{ metadata.customer.contact.name if metadata.customer.contact else '-' }}</td></tr>
    </table>
  </section>

  <section id="inventory">
    <h2>2. 구조진단 대상 시스템</h2>
    <table class="target-systems">
      <tr><th>No</th><th>구분</th><th>hostname</th><th>H/W Model</th><th>Version</th></tr>
      {% for host in hosts %}
      <tr>
        <td>{{ loop.index }}</td>
        <td>{% if host.system_type and host.system_type|lower == 'virtual' %}VM{% elif host.system_type and host.system_type|lower == 'physical' %}Physical{% else %}{{ host.system_type or '-' }}{% endif %}</td>
        <td><strong>{{ host.hostname }}</strong></td>
        <td>{{ host.hardware_model or '-' }}</td>
        <td>{{ host.os_version or '-' }}</td>
      </tr>
      {% endfor %}
    </table>
  </section>

  <section id="summary">
    <h2>3. Hostname별 진단 요약</h2>
    <div class="wide">
      <table>
        <tr><th>Hostname</th><th>구분</th><th>RHEL</th><th>Section</th><th>진단 항목</th><th>Status</th><th>검토 의견</th></tr>
        {% for host in hosts %}
          {% for item in host.diagnostics %}
            {% if item.include_in_report and item.status != 'SKIPPED' %}
            <tr class="{{ item.status }}">
              <td><strong>{{ host.hostname }}</strong></td>
              <td>{{ host.system_type or '-' }}</td>
              <td>{{ host.os_version or '-' }}</td>
              <td>{{ item.section }}</td>
              <td>{{ item.title }}</td>
              <td class="status">{{ item.status }}</td>
              <td>{{ item.summary or '-' }}</td>
            </tr>
            {% endif %}
          {% endfor %}
        {% endfor %}
      </table>
    </div>
  </section>

  <section id="details">
    <h2>4. Hostname별 상세 Report</h2>
    {% for host in hosts %}
      <section class="host-detail">
        <h3>{{ host.hostname }}{% if host.os_version %} — {{ host.os_version }}{% endif %}</h3>
        <p class="muted">Type: {{ host.system_type or '-' }} / H/W Model: {{ host.hardware_model or '-' }}</p>

        {% for item in host.diagnostics %}
          {% if item.include_in_report and item.status != 'SKIPPED' %}
          <article class="diagnostic">
            <h4>{{ item.section }}. {{ item.title }} — <span class="status">{{ item.status }}</span></h4>
            {% if item.summary %}<p>{{ item.summary }}</p>{% endif %}

            {% if item.findings %}
            <h5>Findings</h5>
            <ul>{% for value in item.findings %}<li>{{ value }}</li>{% endfor %}</ul>
            {% endif %}

            {% if item.current_values %}
            <details open>
              <summary>현재 상태</summary>
              <table>
                <tr><th>항목</th><th>값</th></tr>
                {% for key, value in item.current_values.items() %}
                <tr><td>{{ key }}</td><td><code>{{ value }}</code></td></tr>
                {% endfor %}
              </table>
            </details>
            {% endif %}

            {% if item.recommended_values %}
            <details>
              <summary>권고 기준</summary>
              <table>
                <tr><th>항목</th><th>권고값</th></tr>
                {% for key, value in item.recommended_values.items() %}
                <tr><td>{{ key }}</td><td><code>{{ value }}</code></td></tr>
                {% endfor %}
              </table>
            </details>
            {% endif %}

            {% for report_table in item.tables %}
            <div class="wide">
              <table>
                <tr>{% for col in report_table.columns %}<th>{{ col }}</th>{% endfor %}</tr>
                {% for row in report_table.rows %}
                <tr>{% for col in report_table.columns %}<td><code>{{ row.get(col, '-') }}</code></td>{% endfor %}</tr>
                {% endfor %}
              </table>
            </div>
            {% endfor %}

            {% if item.recommendations %}<h5>권장 사항</h5><ul>{% for value in item.recommendations %}<li>{{ value }}</li>{% endfor %}</ul>{% endif %}
            {% if item.remediation %}<h5>조치 사항</h5><ul>{% for value in item.remediation %}<li>{{ value }}</li>{% endfor %}</ul>{% endif %}

            {% if item.evidence %}
            <details>
              <summary>Evidence</summary>
              <ul>{% for evidence in item.evidence %}<li><code>{{ evidence.source }}</code>: {{ evidence.detail }}</li>{% endfor %}</ul>
            </details>
            {% endif %}
          </article>
          {% endif %}
        {% endfor %}
      </section>
    {% endfor %}
  </section>
</body>
</html>
